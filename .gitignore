# Data files
data/*.db
data/*.parquet
data/*.index
data/*.bin
data/*.pkl
data/chembl_*.csv
data/chembl_*.sqlite
data/downloads/*.smi
data/downloads/*.txt
data/downloads/*.sdf
data/progress/*.json
data/progress/tasks.json
backend/*.index
backend/*.pkl

# Third-party data caches — populated locally by loader scripts, never
# redistributed. Anything inside `data/<source>_cache/` is the user's
# own download under that source's license terms.
data/ddinter_cache/
data/drugbank_cache/
data/*_cache/

# Database backups (created by migrations, never tracked)
*.bak
*.db.bak
data/*.bak

# SQLite WAL / SHM (transient, regenerated on every connection)
data/*.db-shm
data/*.db-wal
data/*.db-journal

